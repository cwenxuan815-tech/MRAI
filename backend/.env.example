# ===== Dify 配置（仅在后端使用，前端不可见）=====
# Dify 应用的 API Key（应用 -> 访问 API -> API 密钥）
DIFY_API_KEY=
# Dify API 地址，云端为 https://api.dify.ai/v1，本地部署改为 http://127.0.0.1/v1
DIFY_ENDPOINT=https://api.dify.ai/v1
# 调用 Dify 时携带的用户标识（自定义即可）
DIFY_USER=medical-report-mvp
# Dify 请求超时时间（秒）
DIFY_TIMEOUT=180

# ===== 模拟模式 =====
# true 时不真实调用 Dify，直接返回本地模拟数据，方便前端联调与演示
DIFY_MOCK=true
# mock 场景：green（正常报告）/ yellow（异常提醒）/ red（高风险）/ auto（按 patient_id 自动切换）
# auto 规则：取 patient_id 末位字符的 ASCII 码 % 3，0=green、1=yellow、2=red，保证同一患者结果稳定
DIFY_MOCK_SCENARIO=auto

# ===== Dify Workflow 输入变量名（必须与 Workflow 中实际定义的变量名完全一致，无默认值）=====
# 留空且 DIFY_MOCK=false 时会直接报错提示，不会用臆测的字段名发起请求
DIFY_INPUT_PATIENT_KEY=patient_id
DIFY_INPUT_FILE_KEY=report_image
# 文件变量在 Dify 起始节点中的类型：file-list（文件列表）填 true，file（单文件）填 false
# 填错会被 Dify 拒绝：file-list 必须传数组，否则报 "must be a list of files"
DIFY_INPUT_FILE_IS_LIST=false
# Workflow 中除患者编号、报告文件之外的固定输入，JSON 字符串（没有需求可留空）
# DIFY_EXTRA_INPUTS={"hospital":"示例医院"}

# ===== 存储配置（留空使用默认值）=====
# 上传文件目录，默认 <项目根>/uploads
# UPLOAD_DIR=
# 数据库目录，默认 backend/database（SQLite 文件 app.db 放在此处）
# DATABASE_DIR=
# 数据库连接串，默认 sqlite:///backend/database/app.db
# DATABASE_URL=
# 单个上传文件大小上限（字节），默认 20MB
MAX_UPLOAD_SIZE=20971520
